# BIZRA — Git Attributes
# Ensure shell scripts keep Unix line endings (LF) on Windows checkouts

# Shell scripts — always LF
*.sh text eol=lf
bin/bizra text eol=lf

# Rust source
*.rs text eol=lf

# Python
*.py text eol=lf

# Config
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Markdown / docs
*.md text eol=lf

# JSX / JS / TS
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# AHK (AutoHotKey)
*.ahk text eol=lf

# Seed files
*.seed text eol=lf

# Binary — explicit allowlist (α10: XZ lesson — review all binary blobs)
# Only these binary formats are permitted in the repository.
# Any unlisted binary format triggers a diff review via `git diff --stat`.
*.wasm binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary

# JSONL is text
*.jsonl text eol=lf

# Archives and compiled artifacts — NEVER commit these
*.tar.gz binary
*.zip binary
*.gz binary
*.so binary
*.dylib binary
*.dll binary
*.o binary
*.a binary
*.pyc binary
*.pyo binary

# ═══════════════════════════════════════════════════════════════════════════════
# XZ BACKDOOR DEFENSE — Golden Gem α10
# Standing on Giants: Jia Tan attack (2024) — binary blobs bypass code review
#
# RULE: Any binary file change MUST trigger explicit PR review.
# The XZ payload was hidden in test fixture binary files that were included
# in every build but never inspected. This section ensures:
# 1. All binary changes show up in `git diff --stat`
# 2. Test fixture binaries are explicitly tracked
# 3. Unknown binary formats trigger linguist-detectable warnings
# ═══════════════════════════════════════════════════════════════════════════════

# Test fixtures — binary blobs in test directories require explicit review
# This is exactly where Jia Tan hid the XZ payload
tests/**/*.bin binary diff
tests/**/*.dat binary diff
tests/**/*.fixture binary diff
tests/**/*.snap binary diff
fixtures/**/* binary diff

# Docker / container images — pin by digest, not tag (separate CI concern)
Dockerfile linguist-detectable

# Compiled Rust artifacts — should never appear in source
target/** -diff linguist-vendored

# Node modules — should never appear in source
node_modules/** -diff linguist-vendored

# Model weights — large binary, must be tracked via LFS or blocked
*.onnx binary diff filter=lfs
*.safetensors binary diff filter=lfs
*.gguf binary diff filter=lfs
models/**/* binary diff
