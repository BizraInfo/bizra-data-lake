{
  "_comment": "BIZRA Team MCP Configuration — checked into repo for team-wide consistency",
  "_version": "1.0.0",

  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "description": "Live documentation lookup for libraries (tokio, pyo3, pydantic, fastapi, etc.)"
    },

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-filesystem@latest", "."],
      "description": "Local filesystem access for the repo"
    },

    "memory": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-memory@latest"],
      "description": "Cross-session persistent memory"
    },

    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-fetch@latest"],
      "description": "HTTP fetch for external resources"
    },

    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-sequential-thinking@latest"],
      "description": "Multi-step reasoning and problem decomposition"
    },

    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-github@latest"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      },
      "description": "GitHub issues, PRs, actions integration — set token in .env"
    },

    "brave-search": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-brave-search@latest"],
      "env": {
        "BRAVE_API_KEY": ""
      },
      "description": "Web search — set API key in .env"
    },

    "sqlite": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-sqlite@latest", "./data/bizra.db"],
      "description": "SQLite database for local data queries"
    },

    "bizra-sovereign": {
      "command": "python3",
      "args": ["tools/mcp/sovereign_mcp_server.py", "--stdio"],
      "description": "BIZRA Sovereign Engine MCP — constitutional gates, SNR, Ihsan"
    },

    "bizra-ecosystem": {
      "command": "python3",
      "args": ["tools/mcp/ecosystem_mcp_server.py", "--stdio"],
      "description": "BIZRA Ecosystem health, status, and monitoring"
    }
  }
}
