#!/usr/bin/env bash
# ==============================================================================
# BIZRA NODE0 systemd Environment Override
# ==============================================================================
#
# This file is sourced by all BIZRA systemd services via EnvironmentFile=
# It overrides the WSL paths baked into the .service templates with
# the actual Node0 native Ubuntu paths.
#
# Install location: /etc/bizra/node0.env
# Referenced in: systemd drop-in overrides at /etc/systemd/system/bizra-*.service.d/
#
# ==============================================================================

# Core paths
BIZRA_ROOT=/data/bizra/repos/bizra-data-lake
VIRTUAL_ENV=/data/bizra/repos/bizra-data-lake/.venv
PYTHONPATH=/data/bizra/repos/bizra-data-lake
PATH=/data/bizra/repos/bizra-data-lake/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Data paths
DATA_LAKE_ROOT=/data/bizra/repos/bizra-data-lake
GOLD_PATH=/data/bizra/repos/bizra-data-lake/04_GOLD
STATE_PATH=/data/bizra/repos/bizra-data-lake/sovereign_state

# Node identity
BIZRA_ENV=production
BIZRA_NODE_TYPE=genesis
BIZRA_NODE_ID=node0-genesis

# Constitutional thresholds (HARD CONSTRAINTS — do not lower)
IHSAN_THRESHOLD=0.95
SNR_DATA_THRESHOLD=0.90
SNR_INFORMATION_THRESHOLD=0.95
SNR_KNOWLEDGE_THRESHOLD=0.99
SNR_WISDOM_THRESHOLD=0.999

# Inference (local-first for Node0 — no external dependency)
INFERENCE_PRIMARY=http://127.0.0.1:1234
INFERENCE_FALLBACK=http://localhost:11434

# Autonomous operation
AUTONOMOUS_ENABLED=true
LOOP_INTERVAL_SECONDS=60

# Guardian Council
GUARDIAN_QUORUM=3
GUARDIAN_BYZANTINE_TOLERANCE=1
