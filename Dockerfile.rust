# BIZRA META ALPHA ELITE - Rust Production Container
# Multi-stage build for minimal production image

# ============================================================
# Stage 1: Build
# ============================================================
FROM rust:1.83-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first for better layer caching
COPY Cargo.toml Cargo.lock ./

# Create dummy main to build dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    echo "pub fn lib() {}" > src/lib.rs

# Build dependencies only (cached layer)
RUN cargo build --release && rm -rf src

# Copy actual source
COPY src ./src
COPY constitution ./constitution
COPY static ./static

# Touch to invalidate cache and rebuild with real source
RUN touch src/main.rs src/lib.rs

# Build release binary
RUN cargo build --release --locked

# ============================================================
# Stage 2: Runtime
# ============================================================
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash bizra

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/meta_alpha_dual_agentic /app/bizra-elite

# Copy required assets
COPY --from=builder /app/constitution /app/constitution
COPY --from=builder /app/static /app/static

# Create directories for runtime data
RUN mkdir -p /app/docs/evidence/receipts && \
    chown -R bizra:bizra /app

# Switch to non-root user
USER bizra

# Environment defaults
ENV RUST_LOG=info \
    BIZRA_HTTP_PORT=8080 \
    BIZRA_API_TOKEN="" \
    OLLAMA_URL=http://host.docker.internal:11434 \
    NEO4J_URI=bolt://wisdom:7687 \
    NEO4J_USER=neo4j \
    NEO4J_PASSWORD=bizra_wisdom \
    REDIS_URL=redis://synapse:6379 \
    CHROMA_URL=http://vectors:8000 \
    BIZRA_IHSAN_ENV=staging

EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the binary
CMD ["/app/bizra-elite"]
