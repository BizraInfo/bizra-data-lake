{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizra.io/schemas/sap/v0/meet_open.schema.json",
  "title": "MeetOpen",
  "type": "object",
  "required": [
    "session_id",
    "initiator_agent_id",
    "responder_agent_id",
    "place_id",
    "objective",
    "consent_scope",
    "session_limits",
    "expires_at"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "initiator_agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "responder_agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "place_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "consent_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "product_discovery",
          "price_comparison",
          "preference_sharing",
          "purchase_negotiation",
          "identity_verification",
          "payment_processing",
          "review_submission",
          "data_export"
        ]
      }
    },
    "session_limits": {
      "type": "object",
      "required": [
        "max_messages",
        "max_duration_seconds",
        "max_payload_bytes"
      ],
      "properties": {
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "additionalProperties": false
    },
    "expires_at": {
      "type": "integer"
    },
    "initiator_permit_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
