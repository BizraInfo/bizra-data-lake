# ═══════════════════════════════════════════════════════════════════════════════
# BIZRA NODE0 Genesis Server — Dockerfile
# ═══════════════════════════════════════════════════════════════════════════════
#
# Constitutional Pipeline Server (v6) — Ed25519 identity, Ollama inference,
# signed evidence chain, 7-agent PAT trust compiler.
#
# Standing on Giants: Burns (12-factor app) · Lamport (distributed reliability)
#
# Build:
#   docker build -f deploy/Dockerfile.node0-genesis -t bizra-node0-genesis .
#
# Run:
#   docker run -p 7770:7770 \
#     -e OLLAMA_URL=http://host.docker.internal:11434 \
#     -v ./04_GOLD/node0_data:/app/data \
#     bizra-node0-genesis
# ═══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: Dependencies ──
FROM python:3.12-slim AS deps

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system deps for PyNaCl (Ed25519 crypto)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libsodium-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps — minimal footprint
RUN pip install --no-cache-dir \
    fastapi==0.115.* \
    "uvicorn[standard]==0.34.*" \
    pydantic==2.* \
    pynacl==1.5.*

# ── Stage 2: Application ──
FROM deps AS app

WORKDIR /app

# Copy ONLY the constitutional engine package (self-contained)
COPY bizra-constitution/ /app/bizra-constitution/

# Set PYTHONPATH so imports resolve
ENV PYTHONPATH=/app/bizra-constitution

# Create data directory for evidence chain persistence
RUN mkdir -p /app/data

# Non-root user for security
RUN groupadd -r bizra && useradd -r -g bizra -d /app bizra && \
    chown -R bizra:bizra /app
USER bizra

EXPOSE 7770

# Health check — uses the /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:7770/health | python3 -c \
        "import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get('status')=='operational' else 1)" \
    || exit 1

# Start the server via uvicorn with factory pattern
CMD ["python3", "-m", "uvicorn", \
     "node0_server:create_app", \
     "--factory", \
     "--host", "0.0.0.0", \
     "--port", "7770", \
     "--workers", "1", \
     "--log-level", "info", \
     "--timeout-keep-alive", "30"]
