{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BIZRA Evidence Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "timestamp_utc",
    "actor",
    "action",
    "truth_label",
    "inputs",
    "outputs"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "truth_label": {
      "type": "string",
      "enum": [
        "Measured",
        "Estimated",
        "Target",
        "Unknown"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}