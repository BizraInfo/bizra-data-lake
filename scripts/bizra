case "${1:-}" in
    mission|m)   shift; mission "$*" ;;
    status|s)    status ;;
    agents|a)    agents ;;
    briefing|b)  banner; briefing ;;
    teach|t)     shift; printf 'TEACH\tfact\t%s\t9500\t%d\nSHUTDOWN\n' "$*" "$(date +%s)" | \
                     "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null ;;
    receipts|r|chain) chain ;;
    wallet|w)    wallet ;;
    ghost|g)
        source "$VENV/bin/activate" 2>/dev/null
        python3 -c "
import random
from core.living_memory.brain import LivingMemory
mem = LivingMemory().load()
agents = [
    ('ATLAS','P1','⚔','Patterns in your work suggest focusing on the demo.'),
    ('ORACLE','P2','📚','Found new sources relevant to your research.'),
    ('FORGE','P3','🎨','Uncommitted changes detected. Want me to organize?'),
    ('JUDGE','P4','🛡','All missions passed constitutional gates.'),
    ('CROWN','P5','🌱','Your streak is building. Keep the momentum.'),
    ('HERALD','P6','💬','Adapting to your communication style.'),
    ('NEXUS','P7','🔮','Market trends suggest: prioritize screen recording.'),
]
for c,p,e,m in random.sample(agents,3):
    print(f'  {e} {c} ({p}): {m}')
print(f'\n  Mode: reactive → suggest → auto → partner')
" 2>/dev/null || echo "Ghost Panel offline"
        ;;
    skills)      echo -e "  ${D}╔═══ SOVEREIGN SKILLS ═══╗${R}"; echo -e "  ${G}  organize${R} · ${G}browse${R} · ${G}scan${R} · ${G}mission${R} · ${G}teach${R}"; echo -e "  ${D}╚════════════════════════╝${R}" ;;
    scan)        scripts/bizra scan 2>/dev/null ;;
    organize|o)  shift; mission "Organize and classify files in $*" "file_management" ;;
    browse|web)  shift; mission "Browse and extract: $*" "browse" ;;
    start)
        source "$VENV/bin/activate"
        echo -e "  ${G}Starting sovereign stack...${R}"

        # Kernel daemon
        python3 "$KERNEL" &
        echo -e "  ${G}●${R} Kernel daemon (port 9740)"
        sleep 2

        # Desktop bridge
        python3 -c "
import asyncio
from core.bridges.desktop_bridge import create_and_run_bridge
asyncio.run(create_and_run_bridge())
" &
        echo -e "  ${G}●${R} Desktop bridge (port 9742)"

        # Item 4.1: Federation gossip (if enabled)
        if [ "${BIZRA_FEDERATION_ENABLED:-0}" = "1" ]; then
            GOSSIP_PORT="${BIZRA_GOSSIP_PORT:-9750}"
            echo -e "  ${G}●${R} Federation gossip (port $GOSSIP_PORT)"
            echo -e "  ${DIM}  Seeds: ${BIZRA_SEED_NODES:-none (bootstrap mode)}${R}"
        fi

        # Item 1.5: AHK notification
        if command -v powershell.exe &>/dev/null; then
            powershell.exe -Command "
                if (Test-Path 'C:\\BIZRA-DATA-LAKE\\bin\\bizra_bridge.ahk') {
                    Write-Host 'AHK bridge available: bin\\bizra_bridge.ahk'
                }
            " 2>/dev/null
            echo -e "  ${DIM}  AHK: bin/bizra_bridge.ahk (start manually on Windows)${R}"
        fi

        echo -e ""
        echo -e "  ${G}Sovereign stack running.${R} Use: bizra status"
        ;;
    desktop)
        echo -e "  ${D}╔═══ DESKTOP NERVOUS SYSTEM ═══════════════════════╗${R}"
        # Check bridge
        if python3 -c "
import socket, json
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(2)
s.connect(('127.0.0.1', 9742))
req = json.dumps({'jsonrpc':'2.0','method':'ping','id':1}) + '\n'
s.send(req.encode())
resp = json.loads(s.recv(4096))
s.close()
print(f'  Bridge: ALIVE (uptime {resp.get(\"result\",{}).get(\"uptime_s\",0):.0f}s)')
" 2>/dev/null; then
            echo -e "  ${G}●${R} Desktop Bridge: CONNECTED (port 9742)"
        else
            echo -e "  ${RD}○${R} Desktop Bridge: OFFLINE"
            echo -e "  ${DIM}  Start with: bizra start${R}"
        fi
        # Check AHK
        if powershell.exe -Command "Get-Process AutoHotkey -ErrorAction SilentlyContinue" 2>/dev/null | grep -q "AutoHotkey"; then
            echo -e "  ${G}●${R} AHK Bridge: RUNNING"
