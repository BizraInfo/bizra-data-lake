# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local state
local-*
.claude

# dev runtime
*.log
dev.log
dev.out.log
server.log

# Prisma local dev db
db/custom.db

# Legacy Z.ai (upstream): these dirs were deleted during vendor-lock
# strip. Pattern kept so stray files from npm init flows stay out.
/skills/
/.zscripts/
/mini-services/

# Repo root has a Python-ecosystem `lib/` exclusion; un-ignore the
# TypeScript `src/lib/` directory that holds gateway-client.ts.
!src/lib/
!src/lib/**

# BIZRA smoke-verifier runtime artefacts — receipts + screenshots live
# only locally. Their Merkle root + verdict hashes land in the commit
# message of the run that generated them (Isnad binding).
.bizra/

# bun.lock is authoritative for this project (package.json "start"
# script uses `bun .next/standalone/server.js`). pnpm and npm users
# run their own install locally; their lockfiles stay out of the tree
# to prevent cross-tool drift.
pnpm-lock.yaml
package-lock.json