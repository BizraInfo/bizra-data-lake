#!/bin/bash
# ═══════════════════════════════════════════════════════════
# bizra — The Sovereign AI Terminal
# ═══════════════════════════════════════════════════════════
#
# Usage:
#   bizra                    Interactive sovereign terminal
#   bizra mission "task"     Execute a mission
#   bizra status             System health
#   bizra agents             Show your 12 agents
#   bizra briefing           Morning briefing
#   bizra receipts           Receipt chain
#   bizra teach "fact"       Teach your agents
#   bizra start              Start kernel daemon
#   bizra stop               Stop kernel daemon
#
# بذرة واحدة تصنع غابة — One seed makes a forest.
# ═══════════════════════════════════════════════════════════

set -euo pipefail

BIZRA_ROOT="${BIZRA_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
BINARY="$BIZRA_ROOT/bizra-omega/target/release/bizra-node"
KERNEL="$BIZRA_ROOT/core/sovereign/kernel_daemon.py"
VENV="$BIZRA_ROOT/.venv-linux"
STATE_DIR="$HOME/.bizra/node-1"

G="\033[38;2;125;211;192m"  # BIZRA teal
D="\033[38;2;201;169;98m"   # Gold
R="\033[0m"                  # Reset
B="\033[1m"                  # Bold
DIM="\033[2m"                # Dim

PU="\033[38;2;167;139;250m"  # Purple
BL="\033[38;2;96;165;250m"  # Blue
RD="\033[38;2;239;68;68m"   # Red
GN="\033[38;2;52;211;153m"  # Green

banner() {
    echo -e "${G}"
    echo "  ╔═══════════════════════════════════════════════════════╗"
    echo "  ║                                                       ║"
    echo "  ║           ${B}بِذْرَة${R}${G}  —  BIZRA SOVEREIGN AI              ║"
    echo "  ║                                                       ║"
    echo "  ║   ${DIM}Every human is a node. Every node is a seed.${R}${G}       ║"
    echo "  ║                                                       ║"
    echo "  ╚═══════════════════════════════════════════════════════╝"
    echo -e "${R}"
}

status_bar() {
    source "$VENV/bin/activate" 2>/dev/null
    local info=$(python3 -c "
from core.living_memory.brain import LivingMemory
import json
mem = LivingMemory().load()
u = mem.user
seed = u.total_missions * 12
trend = '↑' if u.ihsan_trend == 'improving' else '↓' if u.ihsan_trend == 'declining' else '→'
ihsan = f'{u.avg_ihsan:.2f}' if u.avg_ihsan > 0 else '0.95'
print(f'{u.tier}|{seed}|{u.current_streak}|{ihsan}|{trend}|{u.total_missions}')
" 2>/dev/null || echo "Novice|0|0|0.95|→|0")

    IFS='|' read -r tier seed streak ihsan trend missions <<< "$info"

    echo -e "  ${DIM}┌─────────────────────────────────────────────────────┐${R}"
    echo -e "  ${DIM}│${R} ${D}⚔${R} ${B}${tier}${R}  ${DIM}│${R} ${D}🌱${R} ${seed} SEED  ${DIM}│${R} ${GN}🔥${R} ${streak} streak  ${DIM}│${R} ${PU}إحسان${R} ${ihsan}${trend}  ${DIM}│${R}"
    echo -e "  ${DIM}└─────────────────────────────────────────────────────┘${R}"
}

mission_result() {
    local response="$1"
    local task="$2"

    local receipt=$(echo "$response" | grep -oP 'receipt_id=\K[a-f0-9]+' | head -1 || true)
    local guardian=$(echo "$response" | grep -oP 'guardian_approved=\K[a-z]+' | head -1 || true)
    local agents=$(echo "$response" | grep -oP 'agents_consulted=\K[0-9]+' | head -1 || true)
    local ihsan=$(echo "$response" | grep -oP 'inference_ihsan=\K[0-9.]+' | head -1 || true)
    local model=$(echo "$response" | grep -oP 'inference_model=\K[^ \t]+' | head -1 || true)
    local reflex=$(echo "$response" | grep -oP 'reflex_hit=\K[a-z]+' | head -1 || true)

    if [ -n "$receipt" ] && [ "$guardian" = "true" ]; then
        echo -e "  ${G}╔═══════════════════════════════════════════════╗${R}"
        echo -e "  ${G}║${R}  ${GN}✓${R} ${B}Mission Complete${R}                            ${G}║${R}"
        echo -e "  ${G}╠═══════════════════════════════════════════════╣${R}"
        echo -e "  ${G}║${R}  ${DIM}Task:${R}     ${task:0:38}  ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}Agents:${R}   ${agents} consulted ${DIM}|${R} P4 Guardian ${GN}✓${R}     ${G}║${R}"
        [ -n "$model" ] && \
        echo -e "  ${G}║${R}  ${DIM}Model:${R}    ${model} ${DIM}|${R} Ihsan ${PU}${ihsan}${R}          ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}Receipt:${R}  ${BL}${receipt:0:24}${R}${DIM}...${R}  ${G}║${R}"
        local seed_info=$(python3 -c "
from core.proof_engine.seed_calc import calculate_seed_reward, format_seed_reward
r = calculate_seed_reward(${ihsan:-0.95}, 0.95, ${agents:-1}, 200, True)
print(format_seed_reward(r))
" 2>/dev/null || echo "+? SEED")
        echo -e "  ${G}║${R}  ${DIM}SEED:${R}     ${D}${seed_info}${R}  ${G}║${R}"
        [ "$reflex" = "true" ] && \
        echo -e "  ${G}║${R}  ${PU}⚡ REFLEX HIT — instant route${R}               ${G}║${R}"
        echo -e "  ${G}╚═══════════════════════════════════════════════╝${R}"
    elif [ "$guardian" = "false" ]; then
        echo -e "  ${RD}╔═══════════════════════════════════════════════╗${R}"
        echo -e "  ${RD}║${R}  ${RD}✗ P4 GUARDIAN VETO${R}                          ${RD}║${R}"
        echo -e "  ${RD}║${R}  ${DIM}Task rejected by constitutional gate${R}       ${RD}║${R}"
        echo -e "  ${RD}╚═══════════════════════════════════════════════╝${R}"
    else
        echo -e "  ${DIM}Response received. No receipt (inference may be offline).${R}"
    fi
}

briefing() {
    source "$VENV/bin/activate" 2>/dev/null
    python3 -c "
from core.living_memory.brain import LivingMemory
mem = LivingMemory().load()
for line in mem.generate_morning_briefing():
    print(f'  ▸ {line}')

# Item 2.1: FAISS-powered context
try:
    from core.proof_engine.faiss_search import search, format_context
    results = search('what am I working on', top_k=3)
    if results:
        print()
        print('  📚 From your sovereign knowledge:')
        for text, dist in results[:3]:
            snippet = text[:80].replace(chr(10), ' ')
            print(f'  ▸ {snippet}...')
except Exception:
    pass
" 2>/dev/null || echo -e "  ${DIM}No memory yet. Start with: bizra teach \"your name is ...\"${R}"
}

agents() {
    echo -e "  ${D}╔═══════════════════════════════════════════════════════╗${R}"
    echo -e "  ${D}║${R}  ${B}YOUR SOVEREIGN AGENT TEAM${R}  ${DIM}(12 agents, soulbound)${R}  ${D}║${R}"
    echo -e "  ${D}╠═══════════════════════════════════════════════════════╣${R}"
    echo -e "  ${D}║${R}                                                       ${D}║${R}"
    echo -e "  ${D}║${R}  ${D}PAT — Personal Agent Team (yours)${R}                   ${D}║${R}"
    echo -e "  ${D}║${R}  ${G}⚔${R}  P1 ${B}Navigator${R}   ${DIM}Route tasks to the right agent${R}   ${D}║${R}"
    echo -e "  ${D}║${R}  ${BL}📚${R} P2 ${B}Scholar${R}     ${DIM}Research, retrieve knowledge${R}     ${D}║${R}"
    echo -e "  ${D}║${R}  ${PU}🎨${R} P3 ${B}Artisan${R}     ${DIM}Create content, write code${R}       ${D}║${R}"
    echo -e "  ${D}║${R}  ${RD}🛡${R}  P4 ${B}Guardian${R}    ${DIM}Safety gate (VETO power)${R}         ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}🌱${R} P5 ${B}Mentor${R}      ${DIM}Learn patterns, grow memory${R}      ${D}║${R}"
    echo -e "  ${D}║${R}  ${BL}💬${R} P6 ${B}Diplomat${R}     ${DIM}Match your communication style${R}  ${D}║${R}"
    echo -e "  ${D}║${R}  ${PU}🔮${R} P7 ${B}Oracle${R}      ${DIM}Predict, plan, suggest proactively${R}${D}║${R}"
    echo -e "  ${D}║${R}                                                       ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}SAT — System Agent Team (URP network)${R}               ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}✓${R}  S1 ${B}Validator${R}   ${DIM}Verify transactions + state${R}      ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}◉${R}  S2 ${B}Oracle${R}      ${DIM}External truth verification${R}      ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}⚖${R}  S3 ${B}Mediator${R}    ${DIM}Resolve disputes fairly${R}          ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}📦${R} S4 ${B}Archivist${R}   ${DIM}Preserve knowledge permanently${R}   ${D}║${R}"
    echo -e "  ${D}║${R}  ${GN}👁${R}  S5 ${B}Sentinel${R}    ${DIM}Network security + threats${R}       ${D}║${R}"
    echo -e "  ${D}║${R}                                                       ${D}║${R}"
    echo -e "  ${D}║${R}  ${DIM}All soulbound. Transfer: REJECTED.${R}                  ${D}║${R}"
    echo -e "  ${D}║${R}  ${DIM}Permission: Human → DEMA → PAT → Pool → SAT${R}        ${D}║${R}"
    echo -e "  ${D}╚═══════════════════════════════════════════════════════╝${R}"
}

chain() {
    echo -e "  ${D}╔═══════════════════════════════════════════════════════╗${R}"
    echo -e "  ${D}║${R}  ${B}RECEIPT CHAIN${R}  ${DIM}(BLAKE3 + Ed25519 signed)${R}          ${D}║${R}"
    echo -e "  ${D}╠═══════════════════════════════════════════════════════╣${R}"
    printf 'ACTION_HISTORY\t10\t0\nSHUTDOWN\n' | \
        "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null | \
        grep "OK" | head -10 | while IFS=$'\t' read -r status rest; do
            echo -e "  ${D}║${R}  ${BL}⬡${R} ${DIM}${rest:0:52}${R}  ${D}║${R}"
        done
    echo -e "  ${D}╚═══════════════════════════════════════════════════════╝${R}"
}

wallet() {
    source "$VENV/bin/activate" 2>/dev/null
    python3 -c "
from core.living_memory.brain import LivingMemory
from core.proof_engine.seed_ledger import balance
mem = LivingMemory().load()
u = mem.user
seed = balance()  # Real SEED from persistent ledger
streak = u.current_streak
tier = u.tier
ihsan = u.avg_ihsan if u.avg_ihsan > 0 else 0.95
trend = u.ihsan_trend

# Tier thresholds
tiers = {'Novice': 50, 'Apprentice': 200, 'Adept': 500, 'Expert': 1000, 'Master': 5000, 'Grandmaster': 999999}
next_tier_at = tiers.get(tier, 50)
progress = min(100, int((u.total_missions / max(1, next_tier_at)) * 100))
bar_len = 20
filled = int(bar_len * progress / 100)
bar = '█' * filled + '░' * (bar_len - filled)

print(f'TIER|{tier}|{bar}|{progress}%|{u.total_missions}/{next_tier_at}')
print(f'SEED|{seed}')
print(f'STREAK|{streak}|{u.streak_record}')
print(f'IHSAN|{ihsan:.4f}|{trend}')
print(f'MISSIONS|{u.total_missions}')

# Item 2.3: Reflex compilation status with detail
near = mem.procedural.near_compilation()
compiled = mem.procedural.compiled_count()
top = mem.procedural.top_reflexes(3)
if near:
    r = near[0]
    remaining = 5 - r.get('cnt', 0)
    print(f'REFLEX|⚡ {r.get(\"p\",\"?\")[:30]} ({r.get(\"cnt\",0)}/5 — {remaining} more!)|{r.get(\"cnt\",0)}/5')
elif compiled > 0:
    print(f'REFLEX|{compiled} compiled reflexes active|ready')
    for ref in top:
        print(f'REFLEX_DETAIL|  ⚡ {ref.get(\"p\",\"?\")[:30]} (used {ref.get(\"cnt\",0)}x)')
else:
    print(f'REFLEX|0 reflexes — complete missions to build patterns|learning')
" 2>/dev/null | while IFS='|' read -r type rest; do
        case "$type" in
            TIER)
                IFS='|' read -r name bar pct progress <<< "$rest"
                echo -e "  ${D}Tier:${R}      ${B}${name}${R}  ${G}${bar}${R} ${pct} (${progress})"
                ;;
            SEED)
                echo -e "  ${D}SEED:${R}      ${D}🌱${R} ${B}${rest}${R} earned"
                ;;
            STREAK)
                IFS='|' read -r current record <<< "$rest"
                echo -e "  ${D}Streak:${R}    ${GN}🔥${R} ${current} current (record: ${record})"
                ;;
            IHSAN)
                IFS='|' read -r score trend <<< "$rest"
                local arrow="→"
                [ "$trend" = "improving" ] && arrow="${GN}↑${R}"
                [ "$trend" = "declining" ] && arrow="${RD}↓${R}"
                echo -e "  ${D}Ihsan:${R}     ${PU}إحسان${R} ${score} ${arrow}"
                ;;
            MISSIONS)
                echo -e "  ${D}Missions:${R}  ${rest} completed"
                ;;
            REFLEX)
                IFS='|' read -r pattern progress <<< "$rest"
                if [ "$progress" = "ready" ]; then
                    echo -e "  ${D}Reflexes:${R}  ${PU}⚡${R} ${pattern}"
                elif [ "$progress" = "learning" ]; then
                    echo -e "  ${D}Reflexes:${R}  ${DIM}${pattern}${R}"
                else
                    echo -e "  ${D}Reflexes:${R}  ${PU}⚡${R} \"${pattern}\" ${D}${progress}${R}"
                fi
                ;;
            REFLEX_DETAIL)
                echo -e "  ${DIM}${rest}${R}"
                ;;
        esac
    done
}

status() {
    echo -e "  ${D}System Status${R}"
    # Check kernel
    if curl -s http://127.0.0.1:9740/api/health >/dev/null 2>&1; then
        local h=$(curl -s http://127.0.0.1:9740/api/health)
        echo -e "  ${G}●${R} Kernel:  ALIVE $(echo $h | python3 -c 'import sys,json; d=json.load(sys.stdin); print(f"v{d.get(\"version\",\"?\")}, up {d.get(\"uptime_s\",0):.0f}s")' 2>/dev/null)"
    else
        echo -e "  ${R}○ Kernel:  OFFLINE — run: bizra start${R}"
    fi
    # Check Ollama
    if curl -s http://localhost:11434/api/tags >/dev/null 2>&1; then
        local models=$(curl -s http://localhost:11434/api/tags | python3 -c 'import sys,json; print(len(json.load(sys.stdin).get("models",[])))' 2>/dev/null)
        echo -e "  ${G}●${R} Ollama:  ${models} models loaded"
    else
        echo -e "  ${R}○ Ollama:  NOT RUNNING${R}"
    fi
    # Check binary
    if [ -f "$BINARY" ]; then
        echo -e "  ${G}●${R} Binary:  $(ls -lh "$BINARY" | awk '{print $5}')"
    else
        echo -e "  ${R}○ Binary:  NOT BUILT — run: cd bizra-omega && cargo build --release -p bizra-node${R}"
    fi
    # State
    echo -e "  ${DIM}  State:   $STATE_DIR${R}"
}

mission() {
    local task="$1"
    local skill="${2:-}"
    echo -e "  ${DIM}⏳ Dispatching to PAT team (full pipeline)...${R}"

    # Run ALL 8 stages through MissionExecutor — the unified pipeline
    source "$VENV/bin/activate" 2>/dev/null
    local REPORT=$(python3 -c "
import sys, json
sys.path.insert(0, '$BIZRA_ROOT')
from core.sovereign.mission_executor import MissionExecutor, format_report
executor = MissionExecutor(state_dir='$STATE_DIR')
report = executor.execute('''$task''', skill='$skill' if '$skill' else None)
# Output structured JSON for bash parsing, then human-readable report
print('BIZRA_JSON:' + json.dumps(report))
print('BIZRA_REPORT:' + format_report(report))
" 2>/dev/null || echo "BIZRA_JSON:{}" )

    # Extract JSON and report
    local JSON_LINE=$(echo "$REPORT" | grep "^BIZRA_JSON:" | sed 's/^BIZRA_JSON://')
    local REPORT_TEXT=$(echo "$REPORT" | grep "^BIZRA_REPORT:" | sed 's/^BIZRA_REPORT://')

    # Parse key fields from JSON
    local receipt_id=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('receipt_id',''))" 2>/dev/null || true)
    local stages_fired=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('stages_fired',0))" 2>/dev/null || true)
    local stages_total=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('stages_total',0))" 2>/dev/null || true)
    local seed_earned=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('seed_earned',0))" 2>/dev/null || true)
    local duration=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('duration_s',0))" 2>/dev/null || true)
    local guardian=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('stages',{}).get('inference',{}).get('guardian',''))" 2>/dev/null || true)
    local model=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('stages',{}).get('inference',{}).get('model',''))" 2>/dev/null || true)
    local ihsan=$(echo "$JSON_LINE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('stages',{}).get('inference',{}).get('ihsan',''))" 2>/dev/null || true)

    if [ -n "$receipt_id" ] && [ "$receipt_id" != "" ]; then
        echo -e "  ${G}╔═══════════════════════════════════════════════╗${R}"
        echo -e "  ${G}║${R}  ${GN}✓${R} ${B}Mission Complete${R}  ${DIM}(${stages_fired}/${stages_total} stages)${R}     ${G}║${R}"
        echo -e "  ${G}╠═══════════════════════════════════════════════╣${R}"
        echo -e "  ${G}║${R}  ${DIM}Task:${R}     ${task:0:38}  ${G}║${R}"
        [ -n "$model" ] && [ "$model" != "" ] && \
        echo -e "  ${G}║${R}  ${DIM}Model:${R}    ${model} ${DIM}|${R} Ihsan ${PU}${ihsan}${R}          ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}Receipt:${R}  ${BL}${receipt_id:0:24}${R}${DIM}...${R}  ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}SEED:${R}     ${D}+${seed_earned}${R}  ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}Duration:${R} ${duration}s  ${G}║${R}"
        echo -e "  ${G}╚═══════════════════════════════════════════════╝${R}"
    elif [ "$guardian" = "false" ]; then
        echo -e "  ${RD}╔═══════════════════════════════════════════════╗${R}"
        echo -e "  ${RD}║${R}  ${RD}✗ P4 GUARDIAN VETO${R}                          ${RD}║${R}"
        echo -e "  ${RD}║${R}  ${DIM}Task rejected by constitutional gate${R}       ${RD}║${R}"
        echo -e "  ${RD}╚═══════════════════════════════════════════════╝${R}"
    else
        # Show pipeline report even when inference is offline
        echo -e "  ${DIM}Pipeline ran ${stages_fired:-0}/${stages_total:-8} stages (inference may be offline)${R}"
    fi

    # Show pipeline breakdown (stages only)
    echo "$REPORT" | grep "^BIZRA_REPORT:" | sed 's/^BIZRA_REPORT://' | while IFS= read -r line; do
        case "$line" in
            *"✓"*|*"○"*) echo -e "  ${DIM}${line}${R}" ;;
        esac
    done
}

interactive() {
    banner
    status_bar
    briefing
    echo ""
    echo -e "  ${DIM}Commands: mission, organize, browse, scan, agents, skills, status, briefing, teach, receipts, help, quit${R}"
    echo ""

    while true; do
        echo -ne "  ${G}بذرة${R} ${D}›${R} "
        read -r cmd args

        case "$cmd" in
            mission|m)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}Task: ${R}"
                    read -r args
                fi
                mission "$args"
                ;;
            agents|a) agents ;;
            status|s) status ;;
            briefing|b) briefing ;;
            teach|t)
                printf 'TEACH\tfact\t%s\t9500\t%d\nSHUTDOWN\n' "$args" "$(date +%s)" | \
                    "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null | \
                    grep "taught" && echo -e "  ${G}✓${R} Learned." || echo -e "  ${R}✗ Failed${R}"
                ;;
            receipts|r) chain ;;
            wallet|w) wallet ;;
            ghost|g)
                echo -e "  ${D}╔═══════════════════════════════════════════════════════╗${R}"
                echo -e "  ${D}║${R}  ${PU}👻 GHOST PANEL${R} — ${DIM}Proactive Agent Intelligence${R}         ${D}║${R}"
                echo -e "  ${D}╠═══════════════════════════════════════════════════════╣${R}"

                source "$VENV/bin/activate" 2>/dev/null
                python3 -c "
import subprocess, json, os, random

# Item 3.1: Ghost with REAL context from FAISS + filesystem
suggestions = []

# Item 3.2: Proactive filesystem watcher
try:
    from core.skills.proactive_watcher import scan_for_changes, format_suggestions
    changes = scan_for_changes()
    for s in format_suggestions(changes):
        suggestions.append(('FORGE', 'P3', '🎨', s))
except Exception:
    pass

# Fallback: check Downloads count
downloads = os.path.expanduser('~/Downloads')
if os.path.isdir(downloads):
    dl_files = [f for f in os.listdir(downloads) if not f.startswith('.')]
    if len(dl_files) > 20:
        suggestions.append(('FORGE', 'P3', '🎨', f'Downloads has {len(dl_files)} files. Organize?'))

# Check git status
try:
    r = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True, timeout=5)
    uncommitted = len([l for l in r.stdout.strip().split(chr(10)) if l.strip()])
    if uncommitted > 0:
        suggestions.append(('FORGE', 'P3', '🎨', f'{uncommitted} uncommitted changes detected. Want me to review?'))
except: pass

# FAISS-powered suggestion
try:
    from core.proof_engine.faiss_search import search
    results = search('what should I focus on next', top_k=1)
    if results:
        topic = results[0][0][:60].replace(chr(10), ' ')
        suggestions.append(('ORACLE', 'P2', '📚', f'Based on your data: \"{topic}...\"'))
except: pass

# Add time-aware suggestions
import time
hour = time.localtime().tm_hour
if hour < 6:
    suggestions.append(('CROWN', 'P5', '🌱', 'Late night session. Remember to rest — sustained excellence requires recovery.'))
elif hour < 9:
    suggestions.append(('CROWN', 'P5', '🌱', 'Early morning — your most productive hours. Focus on the hardest task.'))
elif hour > 21:
    suggestions.append(('CROWN', 'P5', '🌱', 'Evening wind-down. Review what you accomplished today.'))

# Fill remaining with contextual defaults
defaults = [
    ('ATLAS', 'P1', '⚔', 'Ready to route your next mission to the right specialist.'),
    ('JUDGE', 'P4', '🛡', 'Constitutional gates operational. Ihsan floor: 0.95.'),
    ('NEXUS', 'P7', '🔮', 'Prioritize: screen recording → demo → first external users.'),
    ('HERALD', 'P6', '💬', 'Adapting to your communication patterns.'),
]
while len(suggestions) < 3:
    if defaults:
        suggestions.append(defaults.pop(0))
    else:
        break

for callsign, pid, emoji, msg in suggestions[:3]:
    print(f'  {emoji} {callsign} ({pid}): {msg}')
    print()

print('  💡 Mode: reactive → suggest → auto → partner')
" 2>/dev/null || echo -e "  ${DIM}Ghost Panel offline.${R}"

                echo -e "  ${D}╚═══════════════════════════════════════════════════════╝${R}"
                ;;
            organize|o)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}Target directory: ${R}"
                    read -r args
                fi
                echo -e "  ${G}P3 Artisan${R} → Smart File Management"
                echo -e "  ${DIM}Target: $args${R}"

                # Preview plan first
                source "$VENV/bin/activate" 2>/dev/null
                python3 -c "
from core.skills.file_organizer import scan_directory, generate_plan, format_plan
files = scan_directory('$args')
if not files:
    print('  No files found in $args')
else:
    plan = generate_plan(files, '$args')
    print('  ' + format_plan(plan).replace(chr(10), chr(10) + '  '))
    print()
    print('  P4 Guardian: Approve file moves? [Y/n]')
" 2>/dev/null

                echo -ne "  ${G}بذرة${R} ${D}approve?${R} "
                read -r confirm
                if [ "$confirm" != "n" ] && [ "$confirm" != "N" ]; then
                    # Run through FULL pipeline with file_management skill
                    mission "Organize files in $args" "file_management"
                else
                    echo -e "  ${DIM}Cancelled by user.${R}"
                fi
                ;;
            browse|web)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}URL or task: ${R}"
                    read -r args
                fi
                echo -e "  ${G}P2 Scholar${R} → Autonomous Browser Control"

                # Item 1.4: Try MCP brave-search first, fall back to mission
                local WEB_CONTEXT=""
                WEB_CONTEXT=$(python3 -c "
import subprocess, json
try:
    # Use curl to query brave search API via MCP-style
    import urllib.request, urllib.parse
    q = urllib.parse.quote('$args')
    # Direct Ollama with search instruction
    print(f'Search the web for: $args')
except Exception as e:
    print('')
" 2>/dev/null || true)

                mission "Search the web and summarize findings about: $args. Provide factual, sourced information." "browse"
                ;;
            desktop-exec|dx)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}Desktop action: ${R}"
                    read -r args
                fi
                echo -e "  ${G}P1 Navigator${R} → Desktop Execution"
                # Item 1.3: Route through Desktop Bridge
                local BRIDGE_RESULT=""
                BRIDGE_RESULT=$(python3 -c "
import socket, json
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(('127.0.0.1', 9742))
    req = json.dumps({'jsonrpc':'2.0','method':'sovereign_query','params':{'query':'$args'},'id':1})
    s.send((req + chr(10)).encode())
    resp = json.loads(s.recv(8192))
    s.close()
    r = resp.get('result', {})
    print(f'Bridge response: {json.dumps(r)[:200]}')
except ConnectionRefusedError:
    print('Desktop Bridge offline. Start with: bizra start')
except Exception as e:
    print(f'Error: {e}')
" 2>/dev/null)
                echo -e "  ${DIM}$BRIDGE_RESULT${R}"
                mission "$args"
                ;;
            scan)
                echo -e "  ${G}P1 Navigator${R} → Home Scan"
                echo -e "  ${DIM}Scanning sovereign data...${R}"
                echo ""
                echo -e "  ${D}Hardware:${R}"
                echo "    CPU:  $(lscpu 2>/dev/null | grep 'Model name' | sed 's/.*: *//')"
                echo "    RAM:  $(free -h 2>/dev/null | grep Mem | awk '{print $2}')"
                echo "    GPU:  $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"
                echo "    Disk: $(df -h /mnt/c 2>/dev/null | tail -1 | awk '{print $2 " total, " $4 " free"}')"
                echo ""
                echo -e "  ${D}Sovereign Data:${R}"
                for d in /mnt/c/BIZRA-*/; do
                    [ -d "$d" ] && printf "    %-35s %s\n" "$(basename "$d")" "$(find "$d" -maxdepth 2 -type f 2>/dev/null | wc -l) files"
                done 2>/dev/null
                ;;
            skills)
                echo -e "  ${D}╔═══ SOVEREIGN SKILLS ═══════════════════╗${R}"
                echo -e "  ${G}  organize${R}  ${DIM}Smart File Management (classify, rename, merge)${R}"
                echo -e "  ${G}  browse${R}    ${DIM}Autonomous Browser Control (extract, interact)${R}"
                echo -e "  ${G}  scan${R}      ${DIM}Home Scan (hardware + data inventory)${R}"
                echo -e "  ${G}  mission${R}   ${DIM}Any task → PAT team routes to best agent${R}"
                echo -e "  ${G}  teach${R}     ${DIM}Teach your agents a new fact${R}"
                echo -e "  ${D}╚════════════════════════════════════════╝${R}"
                ;;
            help|h)
                echo -e "  ${D}mission${R} <task>   Run a mission with your PAT team"
                echo -e "  ${D}organize${R} <dir>  Organize files (P3 Artisan)"
                echo -e "  ${D}browse${R} <url>    Browse & extract (P2 Scholar)"
                echo -e "  ${D}scan${R}            Home scan (hardware + data)"
                echo -e "  ${D}skills${R}          List sovereign skills"
                echo -e "  ${D}agents${R}           Show your 12 agents"
                echo -e "  ${D}status${R}           System health"
                echo -e "  ${D}briefing${R}         Morning briefing"
                echo -e "  ${D}teach${R} <fact>     Teach your agents"
                echo -e "  ${D}receipts${R}         View receipt chain"
                echo -e "  ${D}wallet${R}           SEED balance, tier, streak, Ihsan"
                echo -e "  ${D}quit${R}             Exit"
                ;;
            quit|q|exit)
                echo -e "  ${DIM}بذرة واحدة تصنع غابة${R}"
                break
                ;;
            "")
                ;;
            *)
                # Treat anything else as a mission
                mission "$cmd $args"
                ;;
        esac
        echo ""
    done
}

