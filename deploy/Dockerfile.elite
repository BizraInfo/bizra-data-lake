# BIZRA Elite Framework — Production Dockerfile
# DevOps v1.2.0 | Phase 31.1 — Cognitive Fusion Pipeline
#
# Multi-stage build for minimal attack surface
# No secrets in image — injected at runtime via environment variables
#
# Build context: repository root (BIZRA-DATA-LAKE/)
# CI usage:  docker build -f deploy/Dockerfile.elite -t bizra-elite .
#
# Standing on Giants: Docker BuildKit, Python 3.12, Ihsan >= 0.95

# =============================================================================
# Stage 1: Builder — install dependencies into isolated venv
# =============================================================================
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies (C extensions, git for VCS installs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy package definition first (layer cache: only rebuilds when deps change)
COPY pyproject.toml ./

# Copy core package source (needed for setuptools to resolve the package)
COPY core/ core/

# Create isolated virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install dependencies — non-editable install for Docker reproducibility
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# =============================================================================
# Stage 2: Runtime — minimal production image
# =============================================================================
FROM python:3.12-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="BIZRA Elite Framework"
LABEL org.opencontainers.image.description="Constitutional CI/CD with Ihsan enforcement"
LABEL org.opencontainers.image.version="1.2.0"
LABEL org.opencontainers.image.vendor="BIZRA"
LABEL org.opencontainers.image.source="https://github.com/BizraInfo/bizra-data-lake"

# Create non-root user (UID/GID 1000 to match K8s securityContext)
RUN groupadd -g 1000 bizra && useradd -u 1000 -g 1000 -d /home/bizra -m bizra

WORKDIR /app

# Copy virtual environment from builder (contains all installed packages)
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code and tests
COPY --chown=bizra:bizra core/ core/
COPY --chown=bizra:bizra tests/ tests/
COPY --chown=bizra:bizra pyproject.toml ./

# Copy static data assets (Sci-Reasoning patterns for RDVE)
COPY --chown=bizra:bizra data/sci_reasoning/ data/sci_reasoning/

# Create runtime state directories (must be writable by non-root user)
# Includes subdirectories created at runtime by sovereign_state, auth, spearpoint
RUN mkdir -p /app/sovereign_state/checkpoints \
             /app/sovereign_state/users \
             /app/.spearpoint/hypothesis_memory \
             /app/logs \
    && chown -R bizra:bizra /app/sovereign_state /app/.spearpoint /app/logs

# Environment — no secrets, only operational config
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BIZRA_ENV=production \
    IHSAN_THRESHOLD=0.95 \
    SNR_THRESHOLD=0.85

# Switch to non-root user
USER bizra

# Health check — validates core stack loads (elite + memory + cognitive fusion)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "\
from core.elite import ELITE_VERSION; \
from core.memory import AgentDB; \
from core.cognitive_fusion import CognitiveFusionEngine; \
from core.marketplace import ExpertRegistry; \
from core.token.emission_decay import LogisticEmissionGate; \
from core.pat.social_recovery import ShamirSplitter; \
print(f'Elite v{ELITE_VERSION} | AgentDB + CognitiveFusion + SAPE OK')"

# Default command — sovereign runtime API server
CMD ["python", "-m", "core.sovereign", "serve", "--host", "0.0.0.0", "--port", "8000"]
