#!/bin/bash
# ═══════════════════════════════════════════════════════════
# bizra — The Sovereign AI Terminal
# ═══════════════════════════════════════════════════════════
#
# Usage:
#   bizra                    Interactive sovereign terminal
#   bizra mission "task"     Execute a mission
#   bizra status             System health
#   bizra agents             Show your 12 agents
#   bizra briefing           Morning briefing
#   bizra receipts           Receipt chain
#   bizra teach "fact"       Teach your agents
#   bizra start              Start kernel daemon
#   bizra stop               Stop kernel daemon
#
# بذرة واحدة تصنع غابة — One seed makes a forest.
# ═══════════════════════════════════════════════════════════

set -euo pipefail

BIZRA_ROOT="${BIZRA_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
BINARY="$BIZRA_ROOT/bizra-omega/target/release/bizra-node"
KERNEL="$BIZRA_ROOT/core/sovereign/kernel_daemon.py"
VENV="$BIZRA_ROOT/.venv-linux"
STATE_DIR="$HOME/.bizra/node-1"

G="\033[38;2;125;211;192m"  # BIZRA teal
D="\033[38;2;201;169;98m"   # Gold
R="\033[0m"                  # Reset
B="\033[1m"                  # Bold
DIM="\033[2m"                # Dim

PU="\033[38;2;167;139;250m"  # Purple
BL="\033[38;2;96;165;250m"  # Blue
RD="\033[38;2;239;68;68m"   # Red
GN="\033[38;2;52;211;153m"  # Green

banner() {
    echo -e "${G}"
    echo "  ╔═══════════════════════════════════════════════════════╗"
    echo "  ║                                                       ║"
    echo "  ║           ${B}بِذْرَة${R}${G}  —  BIZRA SOVEREIGN AI              ║"
    echo "  ║                                                       ║"
    echo "  ║   ${DIM}Every human is a node. Every node is a seed.${R}${G}       ║"
    echo "  ║                                                       ║"
    echo "  ╚═══════════════════════════════════════════════════════╝"
    echo -e "${R}"
}

status_bar() {
    source "$VENV/bin/activate" 2>/dev/null
    local info=$(python3 -c "
from core.living_memory.brain import LivingMemory
import json
mem = LivingMemory().load()
u = mem.user
seed = u.total_missions * 12
trend = '↑' if u.ihsan_trend == 'improving' else '↓' if u.ihsan_trend == 'declining' else '→'
ihsan = f'{u.avg_ihsan:.2f}' if u.avg_ihsan > 0 else '0.95'
print(f'{u.tier}|{seed}|{u.current_streak}|{ihsan}|{trend}|{u.total_missions}')
" 2>/dev/null || echo "Novice|0|0|0.95|→|0")

    IFS='|' read -r tier seed streak ihsan trend missions <<< "$info"

    echo -e "  ${DIM}┌─────────────────────────────────────────────────────┐${R}"
    echo -e "  ${DIM}│${R} ${D}⚔${R} ${B}${tier}${R}  ${DIM}│${R} ${D}🌱${R} ${seed} SEED  ${DIM}│${R} ${GN}🔥${R} ${streak} streak  ${DIM}│${R} ${PU}إحسان${R} ${ihsan}${trend}  ${DIM}│${R}"
    echo -e "  ${DIM}└─────────────────────────────────────────────────────┘${R}"
}

mission_result() {
    local response="$1"
    local task="$2"

    local receipt=$(echo "$response" | grep -oP 'receipt_id=\K[a-f0-9]+' | head -1 || true)
    local guardian=$(echo "$response" | grep -oP 'guardian_approved=\K[a-z]+' | head -1 || true)
    local agents=$(echo "$response" | grep -oP 'agents_consulted=\K[0-9]+' | head -1 || true)
    local ihsan=$(echo "$response" | grep -oP 'inference_ihsan=\K[0-9.]+' | head -1 || true)
    local model=$(echo "$response" | grep -oP 'inference_model=\K[^ \t]+' | head -1 || true)
    local reflex=$(echo "$response" | grep -oP 'reflex_hit=\K[a-z]+' | head -1 || true)

    if [ -n "$receipt" ] && [ "$guardian" = "true" ]; then
        echo -e "  ${G}╔═══════════════════════════════════════════════╗${R}"
        echo -e "  ${G}║${R}  ${GN}✓${R} ${B}Mission Complete${R}                            ${G}║${R}"
        echo -e "  ${G}╠═══════════════════════════════════════════════╣${R}"
        echo -e "  ${G}║${R}  ${DIM}Task:${R}     ${task:0:38}  ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}Agents:${R}   ${agents} consulted ${DIM}|${R} P4 Guardian ${GN}✓${R}     ${G}║${R}"
        [ -n "$model" ] && \
        echo -e "  ${G}║${R}  ${DIM}Model:${R}    ${model} ${DIM}|${R} Ihsan ${PU}${ihsan}${R}          ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}Receipt:${R}  ${BL}${receipt:0:24}${R}${DIM}...${R}  ${G}║${R}"
        echo -e "  ${G}║${R}  ${DIM}SEED:${R}     ${D}+12 earned${R}                         ${G}║${R}"
        [ "$reflex" = "true" ] && \
        echo -e "  ${G}║${R}  ${PU}⚡ REFLEX HIT — instant route${R}               ${G}║${R}"
        echo -e "  ${G}╚═══════════════════════════════════════════════╝${R}"
    elif [ "$guardian" = "false" ]; then
        echo -e "  ${RD}╔═══════════════════════════════════════════════╗${R}"
        echo -e "  ${RD}║${R}  ${RD}✗ P4 GUARDIAN VETO${R}                          ${RD}║${R}"
        echo -e "  ${RD}║${R}  ${DIM}Task rejected by constitutional gate${R}       ${RD}║${R}"
        echo -e "  ${RD}╚═══════════════════════════════════════════════╝${R}"
    else
        echo -e "  ${DIM}Response received. No receipt (inference may be offline).${R}"
    fi
}

briefing() {
    source "$VENV/bin/activate" 2>/dev/null
    python3 -c "
from core.living_memory.brain import LivingMemory
mem = LivingMemory().load()
for line in mem.generate_morning_briefing():
    print(f'  ▸ {line}')
" 2>/dev/null || echo -e "  ${DIM}No memory yet. Start with: bizra teach \"your name is ...\"${R}"
}

agents() {
    echo -e "  ${D}╔═══ YOUR PERSONAL AGENT TEAM (PAT) ═══╗${R}"
    echo -e "  ${G}  P1 Navigator  ${DIM}— Intent routing${R}"
    echo -e "  ${G}  P2 Scholar    ${DIM}— Knowledge retrieval${R}"
    echo -e "  ${G}  P3 Artisan    ${DIM}— Content creation${R}"
    echo -e "  ${G}  P4 Guardian   ${DIM}— Safety + Ihsan (VETO)${R}"
    echo -e "  ${G}  P5 Mentor     ${DIM}— Learning + memory${R}"
    echo -e "  ${G}  P6 Diplomat   ${DIM}— Communication${R}"
    echo -e "  ${G}  P7 Oracle     ${DIM}— Prediction + planning${R}"
    echo -e "  ${D}╠═══ SYSTEM AGENT TEAM (SAT/URP) ═══════╣${R}"
    echo -e "  ${G}  S1 Validator  ${DIM}— State validation${R}"
    echo -e "  ${G}  S2 Oracle     ${DIM}— Truth verification${R}"
    echo -e "  ${G}  S3 Mediator   ${DIM}— Dispute resolution${R}"
    echo -e "  ${G}  S4 Archivist  ${DIM}— Knowledge archive${R}"
    echo -e "  ${G}  S5 Sentinel   ${DIM}— Network security${R}"
    echo -e "  ${D}╚═══════════════════════════════════════╝${R}"
    echo -e "  ${DIM}All soulbound. Transfer: REJECTED.${R}"
}

status() {
    echo -e "  ${D}System Status${R}"
    # Check kernel
    if curl -s http://127.0.0.1:9740/api/health >/dev/null 2>&1; then
        local h=$(curl -s http://127.0.0.1:9740/api/health)
        echo -e "  ${G}●${R} Kernel:  ALIVE $(echo $h | python3 -c 'import sys,json; d=json.load(sys.stdin); print(f"v{d.get(\"version\",\"?\")}, up {d.get(\"uptime_s\",0):.0f}s")' 2>/dev/null)"
    else
        echo -e "  ${R}○ Kernel:  OFFLINE — run: bizra start${R}"
    fi
    # Check Ollama
    if curl -s http://localhost:11434/api/tags >/dev/null 2>&1; then
        local models=$(curl -s http://localhost:11434/api/tags | python3 -c 'import sys,json; print(len(json.load(sys.stdin).get("models",[])))' 2>/dev/null)
        echo -e "  ${G}●${R} Ollama:  ${models} models loaded"
    else
        echo -e "  ${R}○ Ollama:  NOT RUNNING${R}"
    fi
    # Check binary
    if [ -f "$BINARY" ]; then
        echo -e "  ${G}●${R} Binary:  $(ls -lh "$BINARY" | awk '{print $5}')"
    else
        echo -e "  ${R}○ Binary:  NOT BUILT — run: cd bizra-omega && cargo build --release -p bizra-node${R}"
    fi
    # State
    echo -e "  ${DIM}  State:   $STATE_DIR${R}"
}

mission() {
    local task="$1"
    echo -e "  ${DIM}⏳ Dispatching to PAT team...${R}"

    local RESPONSE=$(printf 'START_SESSION\t%d\nRECEIVE\t%s\t%d\nEND_SESSION\t%d\nSHUTDOWN\n' \
        "$(date +%s)" "$task" "$(date +%s)" "$(date +%s)" | \
        BIZRA_ENABLE_OLLAMA_EXECUTE=1 \
        BIZRA_OLLAMA_MODEL="${BIZRA_MODEL:-qwen2.5:3b}" \
        timeout 30 "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null || true)

    mission_result "$RESPONSE" "$task"
}

interactive() {
    banner
    status_bar
    briefing
    echo ""
    echo -e "  ${DIM}Commands: mission, organize, browse, scan, agents, skills, status, briefing, teach, receipts, help, quit${R}"
    echo ""

    while true; do
        echo -ne "  ${G}بذرة${R} ${D}›${R} "
        read -r cmd args

        case "$cmd" in
            mission|m)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}Task: ${R}"
                    read -r args
                fi
                mission "$args"
                ;;
            agents|a) agents ;;
            status|s) status ;;
            briefing|b) briefing ;;
            teach|t)
                printf 'TEACH\tfact\t%s\t9500\t%d\nSHUTDOWN\n' "$args" "$(date +%s)" | \
                    "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null | \
                    grep "taught" && echo -e "  ${G}✓${R} Learned." || echo -e "  ${R}✗ Failed${R}"
                ;;
            receipts|r)
                printf 'ACTION_HISTORY\t10\t0\nSHUTDOWN\n' | \
                    "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null
                ;;
            organize|o)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}Target directory: ${R}"
                    read -r args
                fi
                echo -e "  ${G}P3 Artisan${R} → Smart File Management"
                echo -e "  ${DIM}Target: $args${R}"
                mission "Organize and classify files in $args. Scan, classify by type and content, create folder structure, move files, report what was done."
                ;;
            browse|web|w)
                if [ -z "$args" ]; then
                    echo -ne "  ${DIM}URL or task: ${R}"
                    read -r args
                fi
                echo -e "  ${G}P2 Scholar${R} → Autonomous Browser Control"
                mission "Browse and extract information: $args. Navigate, extract relevant data, summarize findings."
                ;;
            scan)
                echo -e "  ${G}P1 Navigator${R} → Home Scan"
                echo -e "  ${DIM}Scanning sovereign data...${R}"
                echo ""
                echo -e "  ${D}Hardware:${R}"
                echo "    CPU:  $(lscpu 2>/dev/null | grep 'Model name' | sed 's/.*: *//')"
                echo "    RAM:  $(free -h 2>/dev/null | grep Mem | awk '{print $2}')"
                echo "    GPU:  $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"
                echo "    Disk: $(df -h /mnt/c 2>/dev/null | tail -1 | awk '{print $2 " total, " $4 " free"}')"
                echo ""
                echo -e "  ${D}Sovereign Data:${R}"
                for d in /mnt/c/BIZRA-*/; do
                    [ -d "$d" ] && printf "    %-35s %s\n" "$(basename "$d")" "$(find "$d" -maxdepth 2 -type f 2>/dev/null | wc -l) files"
                done 2>/dev/null
                ;;
            skills)
                echo -e "  ${D}╔═══ SOVEREIGN SKILLS ═══════════════════╗${R}"
                echo -e "  ${G}  organize${R}  ${DIM}Smart File Management (classify, rename, merge)${R}"
                echo -e "  ${G}  browse${R}    ${DIM}Autonomous Browser Control (extract, interact)${R}"
                echo -e "  ${G}  scan${R}      ${DIM}Home Scan (hardware + data inventory)${R}"
                echo -e "  ${G}  mission${R}   ${DIM}Any task → PAT team routes to best agent${R}"
                echo -e "  ${G}  teach${R}     ${DIM}Teach your agents a new fact${R}"
                echo -e "  ${D}╚════════════════════════════════════════╝${R}"
                ;;
            help|h)
                echo -e "  ${D}mission${R} <task>   Run a mission with your PAT team"
                echo -e "  ${D}organize${R} <dir>  Organize files (P3 Artisan)"
                echo -e "  ${D}browse${R} <url>    Browse & extract (P2 Scholar)"
                echo -e "  ${D}scan${R}            Home scan (hardware + data)"
                echo -e "  ${D}skills${R}          List sovereign skills"
                echo -e "  ${D}agents${R}           Show your 12 agents"
                echo -e "  ${D}status${R}           System health"
                echo -e "  ${D}briefing${R}         Morning briefing"
                echo -e "  ${D}teach${R} <fact>     Teach your agents"
                echo -e "  ${D}receipts${R}         View receipt chain"
                echo -e "  ${D}quit${R}             Exit"
                ;;
            quit|q|exit)
                echo -e "  ${DIM}بذرة واحدة تصنع غابة${R}"
                break
                ;;
            "")
                ;;
            *)
                # Treat anything else as a mission
                mission "$cmd $args"
                ;;
        esac
        echo ""
    done
}

# ═══════════════════════════════════════
# MAIN DISPATCH
# ═══════════════════════════════════════
case "${1:-}" in
    mission|m)   shift; mission "$*" ;;
    status|s)    status ;;
    agents|a)    agents ;;
    briefing|b)  banner; briefing ;;
    teach|t)     shift; printf 'TEACH\tfact\t%s\t9500\t%d\nSHUTDOWN\n' "$*" "$(date +%s)" | \
                     "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null ;;
    receipts|r)  printf 'ACTION_HISTORY\t10\t0\nSHUTDOWN\n' | \
                     "$BINARY" --user 1 --ihsan 9500 --state-dir "$STATE_DIR" --no-banner 2>/dev/null ;;
    start)       source "$VENV/bin/activate" && python3 "$KERNEL" & echo "Kernel started." ;;
    stop)        pkill -f kernel_daemon.py 2>/dev/null && echo "Kernel stopped." || echo "Not running." ;;
    help|--help|-h) banner; echo "  Usage: bizra [mission|status|agents|briefing|teach|receipts|start|stop|help]" ;;
    "")          interactive ;;
    *)           mission "$*" ;;
esac
