{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BIZRA Unified Cognition Contract v1",
  "description": "Shared API schema between Rust core (8080) and Python kernel (8010)",
  "definitions": {
    "UnifiedCognitionRequest": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "task": {
          "type": "string",
          "description": "Task description for dual-agentic processing",
          "minLength": 1,
          "maxLength": 10000
        },
        "user_id": {
          "type": "string",
          "description": "Optional user identifier",
          "default": "anonymous"
        },
        "ihsan_floor": {
          "type": "number",
          "description": "Minimum Ihsan score required",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.95
        },
        "snr_floor": {
          "type": "number",
          "description": "Minimum SNR score required",
          "minimum": 0.0,
          "default": 7.0
        },
        "context": {
          "type": "object",
          "description": "Additional context key-value pairs",
          "additionalProperties": {
            "type": "string"
          }
        },
        "taint_secrecy": {
          "type": "string",
          "enum": ["Public", "Internal", "Confidential", "Secret"],
          "default": "Internal"
        },
        "taint_integrity": {
          "type": "string",
          "enum": ["Untrusted", "Validated", "Attested", "Sovereign"],
          "default": "Untrusted"
        }
      }
    },
    "UnifiedCognitionResponse": {
      "type": "object",
      "required": ["result", "ihsan_score", "snr_tier", "receipt_id"],
      "properties": {
        "result": {
          "type": "string",
          "description": "Execution result"
        },
        "ihsan_score": {
          "type": "number",
          "description": "Achieved Ihsan score",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "snr_tier": {
          "type": "string",
          "enum": ["T0", "T1", "T2", "T3", "T4", "T5", "T6"],
          "description": "Achieved SNR tier"
        },
        "receipt_id": {
          "type": "string",
          "description": "Evidence receipt identifier"
        },
        "signature": {
          "type": "string",
          "description": "Ed25519 signature of response (hex-encoded)"
        },
        "signer_public_key": {
          "type": "string",
          "description": "Signer public key (hex-encoded)"
        },
        "sat_validation_ms": {
          "type": "integer",
          "description": "SAT validation latency in milliseconds"
        },
        "pat_execution_ms": {
          "type": "integer",
          "description": "PAT execution latency in milliseconds"
        },
        "total_latency_ms": {
          "type": "integer",
          "description": "Total request latency in milliseconds"
        }
      }
    },
    "CognitionError": {
      "type": "object",
      "required": ["error", "code"],
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": ["SAT_BLOCKED", "IHSAN_GATE_FAILED", "EXECUTION_FAILED", "INTERNAL_ERROR"]
        },
        "escalation_id": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        }
      }
    }
  }
}
