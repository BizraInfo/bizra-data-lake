# BIZRA Environment Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to version control

# API Authentication
BIZRA_API_TOKEN=your_secure_token_here

# Neo4j (Wisdom Graph)
NEO4J_AUTH=neo4j/your_password_here
NEO4J_PASSWORD=your_password_here
NEO4J_URI=bolt://localhost:7687

# Redis (Synapse)
REDIS_URL=redis://localhost:6379

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio 0.4.0+ Configuration
# Native v1 API: http://localhost:1234/api/v1/* (recommended)
# OpenAI-compat: http://localhost:1234/v1/* (fallback)
# Anthropic-compat: http://localhost:1234/v1/messages
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_API_VERSION=v1
LMSTUDIO_API_KEY=

# Voice AI (Moshi)
MOSHI_MODEL_PATH=kyutai/moshiko-pytorch-bf16

# Feature Flags
FATE_GATE_ENABLED=true
# Ihsān threshold from constitution/ihsan_v1.yaml (production=0.95, dev=0.80)
IHSAN_THRESHOLD=0.95

# Agentic-Flow (Swarm Intelligence)
AGENTIC_FLOW_URL=http://localhost:3100
AGENTIC_FLOW_ENABLED=true
AGENTIC_FLOW_TIMEOUT=30
AGENTIC_FLOW_MAX_AGENTS=15
AGENTIC_FLOW_DEFAULT_TOPOLOGY=hierarchical-mesh

# Environment
BIZRA_ENV=development
