{
  "name": "BIZRA Versioned Test Lock Policy",
  "version": "1.1",
  "date": "2026-03-09",
  "supersedes": "config/test_lock_policy.json",
  "receipt_schema": "schemas/test_lock_receipt.v1.schema.json",
  "lockable_branch": "main",
  "initial_version": "0.80.0",
  "full_suite_command": "python -m pytest tests/ -q --timeout=120 -m \"not slow and not requires_ollama and not requires_gpu and not requires_network and not e2e_http\" --ignore=tests/e2e_http --tb=no --cov=core --cov-report=term",
  "excludes": [
    "slow",
    "requires_ollama",
    "requires_gpu",
    "requires_network",
    "e2e_http"
  ],
  "lock_conditions": {
    "failed_must_equal": 0,
    "passed_must_equal_total_tests": true,
    "coverage_must_meet_or_exceed_floor": true,
    "critical_security_findings_allowed": 0,
    "constants_hash_review_required_on_change": true,
    "previous_lock_required_except_genesis": true
  },
  "quality_thresholds": {
    "ihsan_min": 0.95,
    "snr_min": 0.85,
    "adl_gini_max": 0.35
  }
}
