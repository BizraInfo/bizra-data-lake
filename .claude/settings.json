{
  "_comment": "BIZRA Advanced Hooks Configuration v3.2 — Closed-Loop Adaptive Intelligence (FATE + ReasoningBank + claude-flow)",
  "_version": "3.2.0",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py session_start",
            "timeout": 10,
            "statusMessage": "Initializing BIZRA session..."
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks session-restore --load-context 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 8,
            "async": true
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py session_end",
            "timeout": 10,
            "statusMessage": "Finalizing BIZRA session..."
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks session-end --export-metrics --generate-summary 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py user_prompt_submit",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks route --task \"$USER_PROMPT\" 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],

    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py permission_request",
            "timeout": 2
          }
        ]
      }
    ],

    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py subagent_start",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks subagent-start --inject-context 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py pre_tool",
            "timeout": 5,
            "statusMessage": "FATE validation..."
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks pre-command 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 3,
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(echo \"$TOOL_INPUT\" | grep -oP \"(?<=file_path|path)[\\\":\\s]+\\K[^\\\"]+\" | head -1); if echo \"$FILE\" | grep -qE \"(ci\\.yml|release\\.yml|docker-compose\\.yml|Cargo\\.lock|requirements\\.lock)\"; then echo \"WARNING: Pinned dependency file — verify SHA/digest pins are preserved after edit.\" >&2; fi'",
            "timeout": 3,
            "statusMessage": "Dependency pin guard..."
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks pre-edit 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 3,
            "async": true
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow hooks pre-task --load-memory 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py pre_tool",
            "timeout": 3
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py post_tool",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow hooks post-command --update-metrics 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(echo \"$TOOL_INPUT\" | grep -oP \"(?<=file_path|path)[\\\":\\s]+\\K[^\\\"]+\" | head -1); if echo \"$FILE\" | grep -qE \"\\.rs$\"; then cd \"$CLAUDE_PROJECT_DIR/bizra-omega\" && cargo fmt --all 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log; fi'",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks post-edit --train-patterns 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "npx claude-flow hooks post-task --analyze-performance --store-decisions 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py post_tool_failure",
            "timeout": 5
          }
        ]
      }
    ],

    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py subagent_stop",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "npx claude-flow hooks subagent-stop --record-metrics 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py stop",
            "timeout": 10,
            "statusMessage": "Saving session state..."
          },
          {
            "type": "command",
            "command": "npx claude-flow memory store --key session-final --value \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/logs/hooks-errors.log || true",
            "timeout": 8,
            "async": true
          }
        ]
      }
    ],

    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py pre_compact",
            "timeout": 5
          }
        ]
      }
    ],

    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bizra_hook_engine.py notification",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(cargo *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(uname *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Read(**)",
      "Write(**)",
      "Edit(**)"
    ]
  }
}
