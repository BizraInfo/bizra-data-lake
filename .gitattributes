# BIZRA — Git Attributes
# Ensure shell scripts keep Unix line endings (LF) on Windows checkouts

# Shell scripts — always LF
*.sh text eol=lf
bin/bizra text eol=lf

# Rust source
*.rs text eol=lf

# Python
*.py text eol=lf

# Config
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Markdown / docs
*.md text eol=lf

# JSX / JS / TS
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# AHK (AutoHotKey)
*.ahk text eol=lf

# Seed files
*.seed text eol=lf

# Binary — explicit allowlist (α10: XZ lesson — review all binary blobs)
# Only these binary formats are permitted in the repository.
# Any unlisted binary format triggers a diff review via `git diff --stat`.
*.wasm binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary

# JSONL is text
*.jsonl text eol=lf

# Archives and compiled artifacts — NEVER commit these
*.tar.gz binary
*.zip binary
*.gz binary
*.so binary
*.dylib binary
*.dll binary
*.o binary
*.a binary
*.pyc binary
*.pyo binary
