# BIZRA-DATA-LAKE Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── BIZRA Root (auto-detected if unset) ──────────────────
# BIZRA_DATA_LAKE_ROOT defaults to the repo root directory.
# Only set this if your data directories live outside the repo.
# BIZRA_DATA_LAKE_ROOT=/home/you/bizra/bizra-data-lake

# ── LLM Backends ─────────────────────────────────────────
# Ollama (default — installed by scripts/install.sh)
OLLAMA_URL=http://localhost:11434
OLLAMA_HOST_ADDR=localhost
OLLAMA_PORT=11434

# LM Studio (optional — auto-detected on WSL via ip route)
# Leave blank if not using LM Studio. WSL gateway is auto-detected.
# LM_STUDIO_API_KEY=
# LM_API_TOKEN=
# LMSTUDIO_HOST=
# LMSTUDIO_PORT=1234

# ── API Keys (optional — only needed for specific features) ──
# Google/Gemini (Layer 4 LLM Extraction)
# GOOGLE_API_KEY=
# LANGEXTRACT_API_KEY=

# Hugging Face (model downloads)
# HF_TOKEN=

# ── XTR-WARP Configuration (ColBERTv2/PLAID + XTR) ──────
# Paths are relative to BIZRA_DATA_LAKE_ROOT
INDEX_ROOT=./03_INDEXED/warp_indexes
EXPERIMENT_ROOT=./04_GOLD/warp_experiments
BEIR_COLLECTION_PATH=./02_PROCESSED/beir
LOTTE_COLLECTION_PATH=./02_PROCESSED/lotte

# WARP Runtime Settings
WARP_CHECKPOINT=answerdotai/answerai-colbert-small-v1
WARP_NBITS=2
WARP_NPROBE=16
WARP_T_PRIME=128
WARP_BOUND=128

# ── Sovereign Identity ───────────────────────────────────
# Desktop Bridge (required for bridge start/ping/status)
# BIZRA_BRIDGE_TOKEN=your_bridge_shared_token_here
# 32-byte signing key as hex (64 hex chars) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# BIZRA_RECEIPT_PRIVATE_KEY_HEX=

# ── Spearpoint Configuration ─────────────────────────────
SPEARPOINT_STATE_DIR=~/.bizra/spearpoint
SPEARPOINT_EVIDENCE_LEDGER=~/.bizra/spearpoint/evidence.jsonl
SPEARPOINT_HYPOTHESIS_MEMORY=~/.bizra/spearpoint/hypothesis_memory
SPEARPOINT_LOOP_INTERVAL=300
SPEARPOINT_MAX_ITERATIONS=10
SPEARPOINT_BUDGET_USD=10.0

# ── Feature Flags (Canary Routing) ───────────────────────
# Boolean kill switches: 0 = hard-disable, 1 = hard-enable.
# LEAVE UNSET to use percent-based canary routing below.
BIZRA_PHASE46_GOT_BRIDGE_ENABLED=0
BIZRA_PHASE46_HMM_ENABLED=0
# Percent routing (0-100). Only active when boolean flag is unset.
BIZRA_PHASE46_SEARCH_PERCENT=10
BIZRA_PHASE46_GOT_BRIDGE_PERCENT=0
BIZRA_PHASE46_HMM_PERCENT=0

# ── Docker Compose Infrastructure ────────────────────────
# Required for `docker compose up` (change these!)
REDIS_PASSWORD=change_me_to_a_strong_password
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password
