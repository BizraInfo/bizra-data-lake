# BIZRA Ghost Overlay — Environment Variable Reference
# Copy to .env and customize before running:
#   docker compose -f deploy/ghost-overlay-compose.yaml up -d
#
# Standing on Giants: Lamport (single source of truth) · Shannon (SNR gating)

# ========================== DEPLOYMENT ================================
BIZRA_ENV=development
# Options: development | staging | production

# ========================== CORE NETWORKING ===========================

# Desktop Bridge (Python JSON-RPC server on port 9742)
BIZRA_BRIDGE_PORT=9742
BIZRA_BRIDGE_TOKEN=<generate-secure-token-here>
# REQUIRED — Desktop Bridge refuses to start without this.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# WebSocket Bridge (FastAPI push server on port 9743)
WS_HOST=0.0.0.0
WS_PORT=9743
WS_MAX_SIZE=65536
# Max WebSocket message size in bytes (default: 64KB)

# ========================== GHOST OVERLAY BEHAVIOR ====================

GHOST_IDLE_TIMEOUT_MS=5000
# Auto-dismiss overlay after this many milliseconds of no gesture.

GHOST_DEBOUNCE_MS=500
# Debounce rapid HHMM predictions within this window.
# Only the highest-confidence prediction fires.

GHOST_MAX_CLIENTS=4
# Maximum concurrent WebSocket connections from Ghost Overlay clients.

GHOST_WS_AUTH_TOKEN=
# Optional auth token for WS handshake.
# Empty = auth disabled (development mode).
# In production, set to a secure random token.

# ========================== GUARDIAN INTEGRATION ======================
# Connect Desktop Bridge to Rust-side FATE gate for constitutional checks.

BIZRA_GUARDIAN_WIRE_MODE=best_effort
# Options: off | best_effort | required
# off          = skip guardian entirely
# best_effort  = try guardian, proceed on timeout
# required     = block action if guardian unreachable

BIZRA_GUARDIAN_HOST=127.0.0.1
BIZRA_GUARDIAN_PORT=9741
BIZRA_GUARDIAN_TIMEOUT_MS=1200

# ========================== NODE IDENTITY =============================

BIZRA_NODE_ROLE=node
# Node role for Desktop Bridge context.

# ========================== AHK OVERLAY (Windows-side) ================

GHOST_WS_HOST=127.0.0.1
GHOST_WS_PORT=9743
# The AHK script connects to this address for health checks.
# For WSL→Windows: use the WSL host IP (e.g., 172.22.x.x or localhost).

GHOST_HOTKEY_SOLIDIFY=#+g
# Win+Shift+G — accept the active suggestion (user-configurable)

GHOST_HOTKEY_DISMISS=Escape
# Escape — dismiss overlay (always active while visible)

GHOST_HOTKEY_NEXT=#+Down
# Win+Shift+Down — scroll to next suggestion card

GHOST_HOTKEY_PREV=#+Up
# Win+Shift+Up — scroll to previous suggestion card

# ========================== CONSTITUTIONAL THRESHOLDS =================
# NOTE: These values are INFORMATIONAL ONLY.
# Actual thresholds are immutable Final[float] in:
#   core/integration/constants.py
# Changing them here has NO EFFECT on runtime behavior.
# To change thresholds, edit constants.py and re-deploy.

# IHSAN_THRESHOLD=0.95
# SNR_THRESHOLD=0.85
