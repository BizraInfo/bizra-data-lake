#cloud-config
autoinstall:
  version: 1

  # ── Identity ──────────────────────────────────────────────────────
  # BEFORE INSTALL: You MUST set a real password hash.
  # Generate: openssl passwd -6 -stdin  (type password, Ctrl+D)
  # Then replace the password line below with the output.
  identity:
    hostname: bizra-node0
    username: mumo
    # NO PASSWORD SET — autoinstall will fail until you provide a real hash.
    # This is intentional. Never commit a real password hash to a public repo.
    password: "SET_PASSWORD_HASH_BEFORE_INSTALL"

  # ── Locale & Keyboard ────────────────────────────────────────────
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # ── Timezone ──────────────────────────────────────────────────────
  timezone: Asia/Dubai

  # ── Network ───────────────────────────────────────────────────────
  # DHCP on all ethernet interfaces — simple and robust
  network:
    version: 2
    ethernets:
      id0:
        match:
          name: "en*"
        dhcp4: true
      id1:
        match:
          name: "eth*"
        dhcp4: true

  # ── Storage ───────────────────────────────────────────────────────
  # Target: 3rd M.2 NVMe slot (dedicated Ubuntu drive)
  # The new NVMe will appear as /dev/nvme2n1 (or similar).
  # nvme0n1 + nvme1n1 are the existing RAID 0 pair (3.73 TB) — DO NOT TOUCH.
  #
  # STRATEGY: Use entire new NVMe for Ubuntu. Do NOT touch RAID drives.
  #
  # Layout (LVM on the new NVMe):
  #   512 MB  — EFI System Partition (/boot/efi)
  #   2 GB    — /boot (ext4)
  #   Rest    — LVM volume group
  #     64 GB   — root (/)
  #     128 GB  — /home (BIZRA data lake, repos, models)
  #     32 GB   — swap (for GPU workloads + hibernation)
  #     Rest    — /data (GOLD corpus, FAISS indexes, model cache)
  #
  # ⚠️  SAFETY: match: smallest targets the NEW NVMe (2 TB), not the
  #     existing RAID 0 (3.73 TB). This is the ONLY safe default.
  #     If your NVMe is larger than the RAID, use interactive install instead.
  #
  # BEFORE INSTALL: Verify with `lsblk` in the live session that the
  # smallest disk is indeed the new NVMe, not a USB or recovery partition.
  # For maximum safety, replace 'smallest' with the exact device path:
  #   match:
  #     path: /dev/nvme2n1
  storage:
    layout:
      name: lvm
      match:
        size: smallest

  # ── SSH ───────────────────────────────────────────────────────────
  ssh:
    install-server: true
    allow-pw: true
    # Add your SSH public key for passwordless access
    # authorized-keys:
    #   - "ssh-ed25519 AAAA... mumo@bizra-node0"

  # ── Packages ──────────────────────────────────────────────────────
  # Minimal base + everything needed for BIZRA bootstrap
  packages:
    # Build essentials
    - build-essential
    - git
    - curl
    - wget
    - unzip
    - cmake
    - ninja-build
    - pkg-config
    - libssl-dev
    - libffi-dev
    # Python
    - python3.12
    - python3.12-venv
    - python3.12-dev
    - python3-pip
    # Z3 solver (required for fate-binding crate)
    - libz3-dev
    # BLAS/LAPACK (FAISS, numpy, scipy)
    - libopenblas-dev
    - libomp-dev
    # Terminal tools
    - htop
    - tmux
    - ripgrep
    - fd-find
    - jq
    - tree
    - neofetch
    # Networking
    - openssh-server
    - net-tools
    # Docker prerequisites
    - ca-certificates
    - gnupg
    - lsb-release
    # Firmware
    - linux-firmware

  # ── Late Commands ─────────────────────────────────────────────────
  # Run after install, before first boot
  late-commands:
    # Copy BIZRA bootstrap script to target
    - cp /cdrom/bizra-payload/migrate-to-linux.sh /target/home/mumo/
    - chmod +x /target/home/mumo/migrate-to-linux.sh
    - chown 1000:1000 /target/home/mumo/migrate-to-linux.sh

    # Copy backup tarball if present
    - test -f /cdrom/bizra-payload/bizra-backup.tar.gz && cp /cdrom/bizra-payload/bizra-backup.tar.gz /target/home/mumo/ || true

    # Enable systemd-resolved for DNS
    - curtin in-target -- systemctl enable systemd-resolved

    # Set BIZRA env vars
    - |
      cat >> /target/home/mumo/.bashrc << 'BIZRA_ENV'

      # ── BIZRA Node0 Environment ──────────────────────────────────
      export BIZRA_DATA_LAKE_ROOT="$HOME/bizra-data-lake"
      export OLLAMA_HOST="http://localhost:11434"
      export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
      bizra() {
          cd "$BIZRA_DATA_LAKE_ROOT"
          source .venv/bin/activate
          ./scripts/bizra "$@"
      }
      # ── End BIZRA ────────────────────────────────────────────────
      BIZRA_ENV

    # Set timezone
    - curtin in-target -- timedatectl set-timezone Asia/Dubai

  # ── Updates ───────────────────────────────────────────────────────
  updates: security

  # ── Shutdown after install ────────────────────────────────────────
  shutdown: reboot
