# Required secrets
REDIS_PASSWORD=replace_with_strong_redis_password
POSTGRES_PASSWORD=replace_with_strong_postgres_password
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
BIZRA_SECRET_KEY=replace_with_runtime_secret
NODE_SECRET=replace_with_64_hex_chars
BIZRA_MCP_GATEWAY_TOKEN=replace_with_strong_gateway_token
BIZRA_BRIDGE_TOKEN=replace_with_bridge_token
BIZRA_BRIDGE_SHUTDOWN_TOKEN=replace_with_shutdown_token

# Desktop Bridge signing keys (Ed25519 hex)
BIZRA_RECEIPT_PRIVATE_KEY_HEX=replace_with_64_hex_ed25519_private_key
BIZRA_RECEIPT_PUBLIC_KEY_HEX=replace_with_64_hex_ed25519_public_key

# Brave Search API key (for real web search in mission pipeline)
BRAVE_API_KEY=replace_with_brave_search_api_key

# Localhost-first service binding defaults
BIZRA_API_HOST=127.0.0.1
BIZRA_API_PORT=3001
BIZRA_API_WORKERS=4
BIZRA_API_MAX_CONNECTIONS=1000
BIZRA_DASHBOARD_HOST=127.0.0.1
OLLAMA_HOST=127.0.0.1:11434
