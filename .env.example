# BIZRA Node0 Citadel — Environment Template
# Copy this file to `.env` and fill secrets locally.
#
# RULE: Never commit `.env` (it is gitignored).

# ----------------------------
# Kernel Auth (required)
# ----------------------------
BIZRA_API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Runtime environment (aliases supported: ENV or BIZRA_ENV)
ENV=PRODUCTION

# FATE strictness (aliases supported: FATE_LEVEL or BIZRA_FATE_STRICT)
# - strict / 1  => fail-closed ethics
# - lenient / 0 => allow degraded mode when constitution missing
FATE_LEVEL=STRICT

# ----------------------------
# Neo4j (Wisdom) — required for graph evidence
# ----------------------------
# Neo4j container expects NEO4J_AUTH=user/password
NEO4J_AUTH=neo4j/CHANGE_ME_NEO4J_PASSWORD

# Kernel uses WISDOM_URL + NEO4J_AUTH for health + connectivity
WISDOM_URL=bolt://wisdom:7687

# Optional legacy (supported by some scripts):
GRAPH_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# ----------------------------
# Redis (Synapse)
# ----------------------------
SYNAPSE_URL=redis://synapse:6379

# ----------------------------
# Vectors (Chroma)
# ----------------------------
CHROMA_URL=http://vectors:8000

# ----------------------------
# Local LLM Providers (host machine)
# ----------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
LMSTUDIO_BASE_URL=http://host.docker.internal:1234

# ----------------------------
# SAPE policy
# ----------------------------
# If 1, /healthz fails when Neo4j is down AND WISDOM_URL/NEO4J_AUTH are configured.
BIZRA_SAPE_REQUIRE_NEO4J_EVIDENCE_H=1

# ----------------------------
# Health probe budgets (seconds)
# ----------------------------
BIZRA_HEALTHZ_BUDGET_S=0.85
BIZRA_HEALTHZ_REDIS_TIMEOUT_S=0.35
BIZRA_HEALTHZ_NEO4J_TIMEOUT_S=0.55
BIZRA_HEALTHZ_LLM_TIMEOUT_S=0.25
BIZRA_HEALTHZ_CACHE_TTL_S=0.5
