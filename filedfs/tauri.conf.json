{
  "$schema": "https://raw.githubusercontent.com/nickswalker/tauri-docs/refs/heads/main/src/schemas/config.schema.json",
  "productName": "BIZRA Node0",
  "version": "0.1.0",
  "identifier": "ai.bizra.node0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BIZRA Node0 — Sovereign AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sovereign AI that knows you",
    "longDescription": "BIZRA Node0 — A sovereign AI node that learns who you are. Every conversation teaches it. Every interaction deepens understanding. Your personal AI that actually knows you.",
    "copyright": "© 2025 BIZRA",
    "category": "Productivity"
  }
}
