{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizra.info/schemas/ci_evidence_receipt_v1.schema.json",
  "title": "BIZRA CI Evidence Receipt v1",
  "description": "Machine-checkable CI execution evidence for governance and auditability",
  "type": "object",
  "required": [
    "schema",
    "timestamp",
    "commit_sha",
    "ref",
    "run_id",
    "gates_passed",
    "ihsan_threshold",
    "integrity_hash"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bizra-ci-evidence-v1",
      "description": "Schema identifier for this receipt type"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the receipt was generated"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Full 40-character Git commit SHA"
    },
    "ref": {
      "type": "string",
      "description": "Git ref (e.g., refs/heads/main, refs/tags/v1.2.0)"
    },
    "run_id": {
      "type": "string",
      "description": "GitHub Actions run ID"
    },
    "run_number": {
      "type": "string",
      "description": "GitHub Actions run number"
    },
    "actor": {
      "type": "string",
      "description": "GitHub username that triggered the workflow"
    },
    "gates_passed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "List of CI gates that passed for this run"
    },
    "gates_failed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "List of CI gates that failed (empty if all passed)"
    },
    "ihsan_threshold": {
      "type": "string",
      "pattern": "^(dev|ci|prod)=0\\.[0-9]{2}$",
      "description": "Ihsān threshold policy applied (e.g., ci=0.90)"
    },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "compile_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Release build time in milliseconds"
        },
        "test_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Test suite execution time in milliseconds"
        },
        "binary_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Release binary size in bytes"
        }
      },
      "description": "Optional performance metrics collected during the run"
    },
    "sat_validation": {
      "type": "object",
      "properties": {
        "tests_run": {
          "type": "integer",
          "minimum": 0
        },
        "tests_passed": {
          "type": "integer",
          "minimum": 0
        },
        "rejection_tests_passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of negative (rejection) tests that passed"
        }
      },
      "description": "SAT validation test results"
    },
    "integrity_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 hash of the receipt content (excluding this field)"
    },
    "attestation": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["sigstore-keyless", "gpg", "github-oidc", "none"],
          "description": "Cryptographic attestation method used"
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded signature (if applicable)"
        },
        "certificate_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to verification certificate (for keyless)"
        }
      },
      "description": "Optional cryptographic attestation"
    }
  },
  "additionalProperties": false
}
