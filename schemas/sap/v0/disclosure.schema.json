{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizra.io/schemas/sap/v0/disclosure.schema.json",
  "title": "Disclosure",
  "type": "object",
  "required": [
    "disclosure_id",
    "claims",
    "source_refs",
    "uncertainty",
    "compliance_assertions"
  ],
  "properties": {
    "disclosure_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref_hash",
          "ref_type"
        ],
        "properties": {
          "ref_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ref_type": {
            "type": "string",
            "enum": [
              "document",
              "dataset",
              "model_output",
              "human_attestation"
            ]
          },
          "ref_uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "score",
        "method",
        "notes"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "compliance_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
