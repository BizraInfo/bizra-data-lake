# ============================================================================
# BIZRA v4.0 - Production Environment Template
# Copy to: deploy/.env  (NEVER commit deploy/.env)
# ============================================================================

# ---- Global ----
BIZRA_ENV=production
BIZRA_LOG_LEVEL=INFO

# ---- Auth ----
# Used by inter-service auth for protected endpoints.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BIZRA_API_KEY=CHANGE_ME__32B_TOKEN

# Optional: Admin token for privileged URP actions
URP_ADMIN_TOKEN=CHANGE_ME__ADMIN_TOKEN

# ---- Service URLs (Compose) ----
NODE_GATEWAY_URL=http://node-gateway:8000
URP_REGISTRY_URL=http://urp-registry:8000
URP_KG_URL=http://urp-knowledge-graph:8000
URP_CONSENSUS_URL=http://urp-consensus:8000
URP_VERIFICATION_URL=http://urp-verification:8000

# ---- Datastores ----
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Generate: openssl rand -hex 16
REDIS_PASSWORD=CHANGE_ME__REDIS_PASSWORD
# Placeholder: for future persistence (Postgres/Neo4j/Chroma) if you expand services

# ---- CORS ----
# Comma-separated allowed origins for Node Gateway (UI, dashboards)
BIZRA_CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting (optional) ----
# Requests per minute per IP (gateway-level). If unset, limiter is disabled.
BIZRA_RATE_LIMIT_RPM=120
